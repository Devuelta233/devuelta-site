---
// Les moyens de nous joindre : un WhatsApp par langue de réponse + l'e-mail.
import { EMAIL, NOM_LANGUE, WHATSAPP, lienWhatsApp } from '../config';
import { C } from '../i18n/commun';
import { LANGS, type Lang } from '../../shared/vocab';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
// La langue de la page d'abord, puis les deux autres.
const ordre: Lang[] = [lang, ...LANGS.filter((l) => l !== lang)];
const bulle = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12Z"/></svg>';
const enveloppe = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>';
---
<ul class="contacts">
  {ordre.map((l) => (
    <li>
      <a class="contact-ligne" href={lienWhatsApp(l)} rel="noopener noreferrer" target="_blank" data-evenement="whatsapp" lang={l}>
        <span class="ico" set:html={bulle} />
        <span>
          <strong>WhatsApp · {NOM_LANGUE[l]}</strong>
          <span class="mono">{WHATSAPP[l].affichage}</span>
        </span>
      </a>
    </li>
  ))}
  <li>
    <a class="contact-ligne" href={`mailto:${EMAIL}`} data-evenement="email">
      <span class="ico" set:html={enveloppe} />
      <span>
        <strong>E-mail · FR · ES · EN</strong>
        <span class="mono">{EMAIL}</span>
      </span>
    </a>
  </li>
</ul>
