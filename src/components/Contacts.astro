---
// Nous joindre : une seule boîte, « Team Devuelta », et le robot Telegram
// officiel quand il est en service. Les adresses officielles sont rappelées pour
// déjouer les faux « Devuelta ».
import { EMAIL, NOM_CONTACT, TELEGRAM_ROBOT, lienTelegram } from '../config';
import { C } from '../i18n/commun';
import type { Lang } from '../../shared/vocab';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const enveloppe = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>';
const avion = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4 20-7z"/></svg>';
const suivi = TELEGRAM_ROBOT ? C.suiviEmailTelegram[lang].replace('{robot}', TELEGRAM_ROBOT) : C.suiviEmail[lang];
---
<ul class="contacts">
  <li>
    <a class="contact-ligne" href={`mailto:${EMAIL}`} data-evenement="email">
      <span class="ico" set:html={enveloppe} />
      <span>
        <strong>{NOM_CONTACT} · Français · Español · English</strong>
        <span class="mono">{EMAIL}</span>
      </span>
    </a>
  </li>
  {TELEGRAM_ROBOT && (
    <li>
      <a class="contact-ligne" href={lienTelegram(lang)} data-evenement="telegram" rel="noopener">
        <span class="ico" set:html={avion} />
        <span>
          <strong>Telegram · Français · Español · English</strong>
          <span class="mono">@{TELEGRAM_ROBOT}</span>
        </span>
      </a>
    </li>
  )}
</ul>
<p class="petit">{suivi}</p>
