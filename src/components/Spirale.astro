---
// La marque officielle de Devuelta : la spirale ouverte (fichier /marque-devuelta.svg).
interface Props {
  class?: string;
  titre?: string;
}
const { class: cls, titre } = Astro.props;
---
<img class={cls} src="/marque-devuelta.svg" alt={titre ?? ''} aria-hidden={titre ? undefined : 'true'} width="166" height="174" />
