---
// La spirale ouverte de Devuelta : facettée, elle ne se referme jamais
// sur son point de départ (on ne revient pas en arrière, on avance).
interface Props {
  class?: string;
  titre?: string;
}
const { class: cls, titre } = Astro.props;
---
<span class={cls} role={titre ? 'img' : undefined} aria-label={titre}>
  <Fragment set:html={`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="50.0" y1="6.0" x2="79.2" y2="20.8" stroke-width="7.20"/><line x1="79.2" y1="20.8" x2="88.5" y2="50.0" stroke-width="6.85"/><line x1="88.5" y1="50.0" x2="75.3" y2="75.3" stroke-width="6.49"/><line x1="75.3" y1="75.3" x2="50.0" y2="83.0" stroke-width="6.14"/><line x1="50.0" y1="83.0" x2="28.6" y2="71.4" stroke-width="5.78"/><line x1="28.6" y1="71.4" x2="22.5" y2="50.0" stroke-width="5.43"/><line x1="22.5" y1="50.0" x2="32.5" y2="32.5" stroke-width="5.08"/><line x1="32.5" y1="32.5" x2="50.0" y2="28.0" stroke-width="4.72"/><line x1="50.0" y1="28.0" x2="63.6" y2="36.4" stroke-width="4.37"/><line x1="63.6" y1="36.4" x2="66.5" y2="50.0" stroke-width="4.02"/><line x1="66.5" y1="50.0" x2="59.7" y2="59.7" stroke-width="3.66"/><line x1="59.7" y1="59.7" x2="50.0" y2="61.0" stroke-width="3.31"/><line x1="50.0" y1="61.0" x2="44.2" y2="55.8" stroke-width="2.95"/><line x1="44.2" y1="55.8" x2="44.5" y2="50.0" stroke-width="2.60"/></svg>`} />
</span>
