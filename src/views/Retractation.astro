---
// « Renoncer au contrat ici » : fonction de rétractation en ligne, obligatoire
// dans l'UE depuis le 19 juin 2026 (directive 2011/83/UE, article 11 bis).
import Base from '../layouts/Base.astro';
import { C } from '../i18n/commun';
import { RETRACTATION } from '../i18n/pages';
import { page, versionsPage } from '../i18n/routes';
import type { Lang } from '../../shared/vocab';
import type { DonneesRetractation } from '../scripts/Retractation';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const donnees: DonneesRetractation = { lang, confidentialite: page('confidentialite', lang) };
---
<Base
  lang={lang}
  titre={RETRACTATION.seo[lang]}
  description={RETRACTATION.meta[lang]}
  chemin={page('retractation', lang)}
  versions={versionsPage('retractation')}
  ariane={[{ nom: RETRACTATION.h1[lang] }]}
>
  <article class="page">
    <h1>{RETRACTATION.h1[lang]}</h1>
    <p class="lede">{RETRACTATION.intro[lang]}</p>
    <ul class="coche">
      {RETRACTATION.points[lang].map((x) => <li>{x}</li>)}
    </ul>
    <p><a href={page('conditions', lang)}>{C.nav.conditions[lang]} →</a></p>
    <div id="retractation">
      <p>{RETRACTATION.sansJs[lang]}</p>
    </div>
    <script type="application/json" id="donnees-retractation" set:html={JSON.stringify(donnees).replace(/</g, '\\u003c')} />
  </article>
</Base>
<script>
  import '../scripts/retractation-app';
</script>
