---
// Page « plateforme × situation » : la ou les démarches officielles de la
// plateforme pour ce problème, vérifiées, avec le lien direct vers le formulaire.
import Base from '../layouts/Base.astro';
import SiCaBloque from '../components/SiCaBloque.astro';
import { C } from '../i18n/commun';
import { PLATEFORME_PAGE } from '../i18n/pages';
import { SEO_PLATEFORME } from '../i18n/seo-plateformes';
import { SITUATIONS_TEXTE } from '../i18n/situations';
import { page, plateformePath, situationPath, type Versions } from '../i18n/routes';
import { actionsPour, dateLisible, PLATEFORMES_VERIFIE_LE, urlAction, type ActionPlateforme, type Plateforme } from '../data';
import { SITE_URL } from '../config';
import { LANGS, SITUATION_LABEL, type Lang, type SituationReelle } from '../../shared/vocab';

interface Props {
  lang: Lang;
  situation: SituationReelle;
  plateforme: Plateforme;
  actions: ActionPlateforme[];
}
const { lang, situation, plateforme, actions } = Astro.props;
const [action, ...suivantes] = actions;
const titreAction = action.titre[lang];
const deux = (s: string) => (lang === 'fr' ? s : s.replace(' : ', ': '));
const h1Defaut = deux(
  titreAction.toLowerCase().includes(plateforme.nom.toLowerCase()) ? titreAction : `${plateforme.nom} : ${titreAction.charAt(0).toLowerCase()}${titreAction.slice(1)}`,
);
const seo = SEO_PLATEFORME[`${situation}:${plateforme.id}`]?.[lang];
const h1 = seo?.h1 ?? h1Defaut;
const titre = seo?.titre ?? h1Defaut;
const chemin = plateformePath(situation, plateforme.id, lang);
const versions = Object.fromEntries(LANGS.map((l) => [l, plateformePath(situation, plateforme.id, l)])) as Versions;
const st = SITUATIONS_TEXTE[situation][lang];
const date = dateLisible(PLATEFORMES_VERIFIE_LE, lang);
const intro = PLATEFORME_PAGE.intro[lang].replace('{p}', plateforme.nom).replace('{d}', date);
const autres = actionsPour(situation).filter((x) => x.plateforme.id !== plateforme.id);
const description = `${h1}. ${action.etapes[lang]?.[0] ?? ''}`.slice(0, 155);
const hote = (u: string) => {
  try {
    return new URL(u).hostname.replace(/^www\./, '');
  } catch {
    return u;
  }
};
// Pas de balisage HowTo : Google ne l'utilise plus (des étapes numérotées en HTML suffisent).
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: h1,
    inLanguage: lang,
    url: `${SITE_URL}${chemin}`,
    dateModified: PLATEFORMES_VERIFIE_LE || '2026-10-15',
    publisher: { '@id': `${SITE_URL}/#organisation` },
  },
];
---
<Base
  lang={lang}
  titre={titre}
  description={description}
  chemin={chemin}
  versions={versions}
  jsonld={jsonld}
  ariane={[
    { nom: C.nav.queFaire[lang], href: page('que-faire', lang) },
    { nom: SITUATION_LABEL[situation][lang], href: situationPath(situation, lang) },
    { nom: plateforme.nom },
  ]}
>
  <article class="page">
    <h1>{h1}</h1>
    <p class="lede">{intro}</p>

    <div class="encadre">
      <h2 class="sans-marge">{PLATEFORME_PAGE.conseils[lang]}</h2>
      <ul class="coche">
        {st.premiers.map((p) => <li>{p}</li>)}
      </ul>
    </div>

    {[action, ...suivantes].map((a, i) => {
      const lien = urlAction(a, lang);
      return (
        <section aria-labelledby={`demarche-${i}`}>
          <h2 id={`demarche-${i}`}>{i === 0 ? PLATEFORME_PAGE.etapes[lang] : deux(a.titre[lang])}</h2>
          {i === 0 && suivantes.length > 0 && <p><strong>{deux(a.titre[lang])}</strong></p>}
          <ol class="etapes">
            {(a.etapes[lang] ?? []).map((e) => <li>{e}</li>)}
          </ol>
          <div class="actions">
            <a class={`bouton ${i === 0 ? 'principal' : ''}`} href={lien} rel="noopener noreferrer" target="_blank">
              {C.ouvrirFormulaire[lang]}
              <small>{hote(lien)} {C.nouvelOnglet[lang]}</small>
            </a>
          </div>
          <p class="petit">{a.connexion_requise ? C.connexionRequise[lang] : C.pasDeConnexion[lang]} {C.verifieLe[lang]} {date}.</p>
        </section>
      );
    })}

    <SiCaBloque lang={lang} />

    {autres.length > 0 && (
      <section aria-labelledby="autres">
        <h2 id="autres">{PLATEFORME_PAGE.autres[lang]}</h2>
        <ul class="cartes deux">
          {autres.map((x) => (
            <li>
              <a class="carte" href={plateformePath(situation, x.plateforme.id, lang)}>
                <span class="carte-titre">{x.plateforme.nom}</span>
                <span class="carte-texte">{x.action.titre[lang]}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
    <p><a href={situationPath(situation, lang)}>← {st.seo}</a></p>
    <p class="petit">{C.pasConseilJuridique[lang]}</p>
  </article>
</Base>
